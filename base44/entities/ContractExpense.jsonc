{
  "name": "ContractExpense",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "fuel",
        "maintenance",
        "salik_tolls",
        "insurance",
        "registration",
        "other"
      ],
      "default": "other"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "liters": {
      "type": "number"
    },
    "price_per_liter": {
      "type": "number"
    }
  },
  "required": [
    "contract_id",
    "category",
    "amount",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}