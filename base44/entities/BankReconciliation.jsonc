{
  "name": "BankReconciliation",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "deposit": {
      "type": "number",
      "default": 0
    },
    "withdrawal": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "deposit",
    "withdrawal"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}