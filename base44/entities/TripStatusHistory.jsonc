{
  "name": "TripStatusHistory",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "trip_number": {
      "type": "string"
    },
    "previous_status": {
      "type": "string"
    },
    "new_status": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ],
      "default": "manual"
    },
    "changed_by": {
      "type": "string"
    },
    "changed_at": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "new_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}