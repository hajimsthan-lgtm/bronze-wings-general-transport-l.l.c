{
  "name": "VendorExpense",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "cash",
        "bank"
      ],
      "default": "cash"
    }
  },
  "required": [
    "vendor_name",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}