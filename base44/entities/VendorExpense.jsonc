{
  "name": "VendorExpense",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "vendor_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "source": {
      "type": "string",
      "enum": [
        "cash",
        "bank"
      ],
      "default": "cash"
    }
  },
  "required": [
    "vendor_name",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}