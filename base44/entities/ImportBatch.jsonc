{
  "name": "ImportBatch",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "filename": {
      "type": "string"
    },
    "row_count": {
      "type": "number",
      "default": 0
    },
    "imported_by": {
      "type": "string"
    },
    "imported_datetime": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "undone"
      ],
      "default": "active"
    },
    "undone_by": {
      "type": "string"
    },
    "undone_datetime": {
      "type": "string"
    },
    "rows_removed": {
      "type": "number",
      "default": 0
    },
    "reconciled_removed": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "batch_id",
    "entity_type",
    "filename",
    "row_count",
    "imported_by",
    "imported_datetime"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}