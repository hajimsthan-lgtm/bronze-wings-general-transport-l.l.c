{
  "name": "InvoiceCounter",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "invoice",
        "quotation"
      ]
    },
    "period": {
      "type": "string"
    },
    "last_seq": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "type",
    "period"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}