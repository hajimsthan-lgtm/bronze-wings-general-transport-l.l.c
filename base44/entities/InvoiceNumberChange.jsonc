{
  "name": "InvoiceNumberChange",
  "type": "object",
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string",
      "description": "Current invoice number after change"
    },
    "from_number": {
      "type": "string"
    },
    "to_number": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "changed_by": {
      "type": "string"
    },
    "changed_at": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "manual_edit",
        "auto_reallocate",
        "undo",
        "redo",
        "delete_renumber",
        "rearrange_only"
      ],
      "default": "manual_edit"
    },
    "reallocated_invoices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "invoice_id": {
            "type": "string"
          },
          "from_number": {
            "type": "string"
          },
          "to_number": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "undo_snapshot": {
      "type": "object",
      "additionalProperties": true,
      "description": "Snapshot of all invoice numbers before this change, for undo"
    }
  },
  "required": [
    "invoice_id",
    "from_number",
    "to_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}