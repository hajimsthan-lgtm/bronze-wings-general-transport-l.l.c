{
  "name": "TripFixLog",
  "type": "object",
  "properties": {
    "trip_id": {
      "type": "string"
    },
    "trip_number": {
      "type": "string"
    },
    "rule_id": {
      "type": "string"
    },
    "rule_title": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "old_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "fixed_by": {
      "type": "string"
    },
    "fixed_at": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "trip_id",
    "rule_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}