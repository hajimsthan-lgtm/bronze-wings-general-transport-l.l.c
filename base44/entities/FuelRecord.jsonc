{
  "name": "FuelRecord",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "liters": {
      "type": "number"
    },
    "price_per_liter": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "vat_rate": {
      "type": "number",
      "default": 5
    },
    "vat_amount": {
      "type": "number",
      "default": 0
    },
    "total_with_vat": {
      "type": "number",
      "default": 0
    },
    "odometer_reading": {
      "type": "number"
    },
    "station_name": {
      "type": "string"
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "diesel",
        "petrol"
      ],
      "default": "diesel"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card",
        "petty_wallet"
      ],
      "default": "cash"
    },
    "receipt_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "vehicle_plate",
    "liters",
    "total_cost"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}