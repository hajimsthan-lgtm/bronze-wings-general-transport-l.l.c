{
  "name": "DriverDeduction",
  "type": "object",
  "properties": {
    "driver_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "housing_advance",
        "vehicle_loan",
        "traffic_fine",
        "salary_advance",
        "equipment",
        "other"
      ],
      "default": "other"
    },
    "description": {
      "type": "string"
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "monthly_deduction": {
      "type": "number",
      "default": 0
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed"
      ],
      "default": "active"
    },
    "remaining_balance": {
      "type": "number",
      "default": 0
    },
    "months_left": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "driver_name",
    "type",
    "total_amount",
    "monthly_deduction",
    "issue_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}