{
  "name": "Service",
  "type": "object",
  "properties": {
    "main_category": {
      "type": "string"
    },
    "sub_category": {
      "type": "string"
    },
    "service_type": {
      "type": "string"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "link": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    }
  },
  "required": [
    "main_category",
    "service_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}