{
  "name": "CompanyDocument",
  "type": "object",
  "properties": {
    "document_type": {
      "type": "string"
    },
    "reference_number": {
      "type": "string"
    },
    "issuing_authority": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "file_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "alert_days": {
      "type": "number",
      "default": 30
    },
    "renewal_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "old_expiry": {
            "type": "string",
            "format": "date"
          },
          "new_expiry": {
            "type": "string",
            "format": "date"
          },
          "renewed_date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "document_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}