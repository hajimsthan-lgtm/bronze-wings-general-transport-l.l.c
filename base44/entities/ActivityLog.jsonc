{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "user_name": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "login",
        "logout",
        "export",
        "import",
        "status_change",
        "payment",
        "view",
        "other"
      ],
      "default": "other"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_name": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "user_name",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}