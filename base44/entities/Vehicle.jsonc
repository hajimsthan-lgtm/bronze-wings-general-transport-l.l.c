{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "plate_number": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "make": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "truck",
        "trailer",
        "tanker",
        "pickup",
        "other"
      ],
      "default": "truck"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "inactive"
      ],
      "default": "active"
    },
    "assigned_driver": {
      "type": "string"
    },
    "registration_expiry": {
      "type": "string",
      "format": "date"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date"
    },
    "last_service_date": {
      "type": "string",
      "format": "date"
    },
    "next_service_date": {
      "type": "string",
      "format": "date"
    },
    "odometer_km": {
      "type": "number",
      "default": 0
    },
    "fuel_type": {
      "type": "string",
      "enum": [
        "diesel",
        "petrol"
      ],
      "default": "diesel"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "plate_number",
    "make",
    "model"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}