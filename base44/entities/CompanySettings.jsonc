{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone1": {
      "type": "string"
    },
    "phone2": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "trn": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "default_vat_rate": {
      "type": "number",
      "default": 5
    },
    "invoice_prefix": {
      "type": "string",
      "default": "BW"
    },
    "bank_name": {
      "type": "string"
    },
    "bank_account_title": {
      "type": "string"
    },
    "bank_account_no": {
      "type": "string"
    },
    "bank_iban": {
      "type": "string"
    },
    "bank_branch": {
      "type": "string"
    },
    "inv_header_bg": {
      "type": "string",
      "default": "#f0f0f0"
    },
    "inv_header_text": {
      "type": "string",
      "default": "#000000"
    },
    "inv_row_text": {
      "type": "string",
      "default": "#000000"
    },
    "inv_row_alt_bg": {
      "type": "string",
      "default": "#fafbfc"
    },
    "inv_desc_align": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "inv_num_align": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "right"
    },
    "inv_logo_source": {
      "type": "string",
      "enum": [
        "company",
        "custom"
      ],
      "default": "company"
    },
    "inv_logo_url": {
      "type": "string"
    },
    "inv_logo_size": {
      "type": "number",
      "default": 16
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}