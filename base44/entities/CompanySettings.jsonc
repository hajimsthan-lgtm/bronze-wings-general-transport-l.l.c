{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone1": {
      "type": "string"
    },
    "phone2": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "trn": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "default_vat_rate": {
      "type": "number",
      "default": 5
    },
    "invoice_prefix": {
      "type": "string",
      "default": "BW"
    },
    "invoice_last_seq": {
      "type": "number",
      "default": 0
    },
    "invoice_last_year": {
      "type": "number",
      "default": 0
    },
    "invoice_seq_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_number": {
            "type": "string"
          },
          "to_number": {
            "type": "string"
          },
          "changed_by": {
            "type": "string"
          },
          "changed_date": {
            "type": "string"
          },
          "invoice_id": {
            "type": "string"
          }
        }
      }
    },
    "bank_name": {
      "type": "string"
    },
    "bank_account_title": {
      "type": "string"
    },
    "bank_account_no": {
      "type": "string"
    },
    "bank_iban": {
      "type": "string"
    },
    "bank_branch": {
      "type": "string"
    },
    "inv_header_bg": {
      "type": "string",
      "default": "#f0f0f0"
    },
    "inv_header_text": {
      "type": "string",
      "default": "#000000"
    },
    "inv_row_text": {
      "type": "string",
      "default": "#000000"
    },
    "inv_row_alt_bg": {
      "type": "string",
      "default": "#fafbfc"
    },
    "inv_desc_align": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "inv_num_align": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "center"
    },
    "inv_logo_source": {
      "type": "string",
      "enum": [
        "company",
        "custom"
      ],
      "default": "company"
    },
    "inv_logo_url": {
      "type": "string"
    },
    "inv_logo_size": {
      "type": "number",
      "default": 16
    },
    "vendor_rate_percentage": {
      "type": "number",
      "default": 80
    },
    "template_config": {
      "type": "object",
      "additionalProperties": true
    },
    "overtime_scenario": {
      "type": "string",
      "enum": [
        "standard",
        "tiered",
        "flat_daily",
        "weekend_multiplier"
      ],
      "default": "standard"
    },
    "overtime_rate": {
      "type": "number",
      "default": 0
    },
    "overtime_tier1_multiplier": {
      "type": "number",
      "default": 1.25
    },
    "overtime_tier2_multiplier": {
      "type": "number",
      "default": 1.5
    },
    "overtime_tier2_threshold": {
      "type": "number",
      "default": 2
    },
    "overtime_flat_daily": {
      "type": "number",
      "default": 0
    },
    "overtime_weekend_multiplier": {
      "type": "number",
      "default": 1.5
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}