{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone1": {
      "type": "string"
    },
    "phone2": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "trn": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "default_vat_rate": {
      "type": "number",
      "default": 5
    },
    "invoice_prefix": {
      "type": "string",
      "default": "BW"
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}