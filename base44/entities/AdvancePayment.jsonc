{
  "name": "AdvancePayment",
  "type": "object",
  "properties": {
    "reference_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "remaining_amount": {
      "type": "number",
      "default": 0
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "used"
      ],
      "default": "active"
    }
  },
  "required": [
    "reference_number",
    "customer_name",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}