{
  "name": "MonthlyContract",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false
    },
    "monthly_rate": {
      "type": "number",
      "default": 0,
      "description": "Legacy field \u2014 kept for backward compatibility. Use contract_rate for new contracts."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "terminated"
      ],
      "default": "active"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "driver_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "allowance_days": {
      "type": "number",
      "default": 0,
      "description": "Days included in the base contract price for the billing period"
    },
    "allowance_hours_per_day": {
      "type": "number",
      "default": 0,
      "description": "Hours per day included before overage kicks in"
    },
    "contract_rate": {
      "type": "number",
      "default": 0,
      "description": "Base price for the allowance"
    },
    "extra_day_rate": {
      "type": "number",
      "default": 0,
      "description": "Price charged per day beyond allowance_days"
    },
    "extra_hour_rate": {
      "type": "number",
      "default": 0,
      "description": "Price charged per hour beyond allowance_hours_per_day on any day"
    },
    "prorate_underuse": {
      "type": "boolean",
      "default": false,
      "description": "Credit unused days when actual usage is below allowance"
    },
    "daily_usage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "hours_used": {
            "type": "number",
            "default": 0
          }
        }
      },
      "default": []
    },
    "avg_hours_per_day": {
      "type": "number",
      "default": 0,
      "description": "Quick mode \u2014 same hour figure applied to every day (approximation)"
    },
    "add_ons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "default": 0
          },
          "vat_included": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "default": []
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}