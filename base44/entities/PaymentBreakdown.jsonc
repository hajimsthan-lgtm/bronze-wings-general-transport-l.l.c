{
  "name": "PaymentBreakdown",
  "type": "object",
  "properties": {
    "transaction_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "card"
      ]
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "mode",
    "amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}