{
  "name": "GeneratedPrompt",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "prompt"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}